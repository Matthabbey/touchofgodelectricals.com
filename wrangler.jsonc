{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "touchofgodelectricals-com",
  "compatibility_date": "2026-10-23",
  // The site is a Next.js static export (output: "export" in next.config.ts).
  // `npm run build` writes it to ./out, and Workers serves that folder as static assets.
  // No OpenNext / server runtime is needed.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
